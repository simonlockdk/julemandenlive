# Nordpolens Kontrolcentral – miljøvariabler
# Produktion: kopiér til ~/.config/nordpolen/nordpolen.env (chmod 600)
# Lokal udvikling: kopiér til .env og start med  node --env-file=.env dist/server/index.js

# Administratorens brugernavn
ADMIN_USER=julemanden
# Lav hashen med:  npm run hash-password   (indsæt uden anførselstegn)
ADMIN_PASSWORD_HASH=

# Hvor længe et admin-login varer (timer)
SESSION_HOURS=8

# Maks. størrelse på uploadede videoer (MB). Husk også LimitRequestBody i Apache.
MAX_UPLOAD_MB=1024

# Ekstra kilder til video, hvis du streamer HLS fra et andet domæne (mellemrumssepareret)
# EXTRA_MEDIA_SRC=https://cdn.eksempel.dk

# Kun til udvikling – lad være udkommenteret i produktion:
# NODE_ENV=development
# TIME_MACHINE_FOR_ALL=true
# COOKIE_SECURE=false
