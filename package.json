{
  "name": "nordpolens-kontrolcentral",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Nordpolens Kontrolcentral – Danmarks hyggeligste juleportal",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "esbuild src/server/index.ts src/server/tools/hash-password.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist/server --packages=external",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "hash-password": "tsx src/server/tools/hash-password.ts",
    "e2e": "node scripts/e2e.mjs",
    "screenshots": "node scripts/screenshot.mjs",
    "start:dev-env": "node --env-file=.env dist/server/index.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^10.1.12",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@testing-library/react": "^16.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "hls.js": "^1.7.4",
    "jsdom": "^31.0.1",
    "maplibre-gl": "^6.19.0",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
